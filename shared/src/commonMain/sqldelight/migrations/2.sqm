CREATE TABLE doc_folder (
    id TEXT NOT NULL PRIMARY KEY,
    updatedAt INTEGER NOT NULL,
    deleted INTEGER NOT NULL,
    serverSeq INTEGER NOT NULL DEFAULT 0,
    syncState TEXT NOT NULL,
    name TEXT NOT NULL
);

CREATE TABLE doc (
    id TEXT NOT NULL PRIMARY KEY,
    updatedAt INTEGER NOT NULL,
    deleted INTEGER NOT NULL,
    serverSeq INTEGER NOT NULL DEFAULT 0,
    syncState TEXT NOT NULL,
    folderId TEXT,
    title TEXT NOT NULL,
    body TEXT NOT NULL,
    source TEXT NOT NULL
);

CREATE TABLE ai_job (
    id TEXT NOT NULL PRIMARY KEY,
    updatedAt INTEGER NOT NULL,
    deleted INTEGER NOT NULL,
    serverSeq INTEGER NOT NULL DEFAULT 0,
    syncState TEXT NOT NULL,
    kind TEXT NOT NULL,
    inputJson TEXT NOT NULL,
    status TEXT NOT NULL,
    resultJson TEXT,
    error TEXT,
    attempts INTEGER NOT NULL,
    createdAt INTEGER NOT NULL,
    startedAt INTEGER
);

CREATE TABLE dream (
    id TEXT NOT NULL PRIMARY KEY,
    updatedAt INTEGER NOT NULL,
    deleted INTEGER NOT NULL,
    serverSeq INTEGER NOT NULL DEFAULT 0,
    syncState TEXT NOT NULL,
    localDate TEXT NOT NULL,
    text TEXT NOT NULL,
    mood INTEGER NOT NULL,
    lucid INTEGER NOT NULL,
    tags TEXT NOT NULL,
    analysis TEXT,
    analysisModel TEXT
);

CREATE TABLE dream_pattern (
    id TEXT NOT NULL PRIMARY KEY,
    updatedAt INTEGER NOT NULL,
    deleted INTEGER NOT NULL,
    serverSeq INTEGER NOT NULL DEFAULT 0,
    syncState TEXT NOT NULL,
    localDate TEXT NOT NULL,
    text TEXT NOT NULL,
    model TEXT NOT NULL
);

CREATE TABLE goal (
    id TEXT NOT NULL PRIMARY KEY,
    updatedAt INTEGER NOT NULL,
    deleted INTEGER NOT NULL,
    serverSeq INTEGER NOT NULL DEFAULT 0,
    syncState TEXT NOT NULL,
    title TEXT NOT NULL,
    why TEXT,
    deadline TEXT,
    status TEXT NOT NULL
);

ALTER TABLE task ADD COLUMN goalId TEXT;
