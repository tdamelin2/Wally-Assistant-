CREATE TABLE exam (
    id TEXT NOT NULL PRIMARY KEY,
    updatedAt INTEGER NOT NULL,
    deleted INTEGER NOT NULL,
    serverSeq INTEGER NOT NULL DEFAULT 0,
    syncState TEXT NOT NULL,
    courseId TEXT,
    title TEXT NOT NULL,
    localDate TEXT NOT NULL,
    time TEXT
);

selectAll:
SELECT * FROM exam;

selectById:
SELECT * FROM exam WHERE id = ?;

selectPending:
SELECT * FROM exam WHERE syncState = 'PENDING';

upsert:
INSERT OR REPLACE INTO exam VALUES ?;

markSynced:
UPDATE exam SET syncState = 'SYNCED' WHERE id = ? AND updatedAt = ?;

markRejected:
UPDATE exam SET syncState = 'REJECTED' WHERE id = ? AND updatedAt = ?;

selectChangedSince:
SELECT * FROM exam WHERE serverSeq > ? ORDER BY serverSeq ASC;

selectAllActive:
SELECT * FROM exam WHERE deleted = 0 ORDER BY localDate ASC, time ASC, id ASC;
