CREATE TABLE health_day (
    id TEXT NOT NULL PRIMARY KEY,
    updatedAt INTEGER NOT NULL,
    deleted INTEGER NOT NULL,
    serverSeq INTEGER NOT NULL DEFAULT 0,
    syncState TEXT NOT NULL,
    localDate TEXT NOT NULL,
    sleepMinutes INTEGER,
    steps INTEGER,
    restingHr INTEGER
);

selectAll:
SELECT * FROM health_day;

selectById:
SELECT * FROM health_day WHERE id = ?;

selectPending:
SELECT * FROM health_day WHERE syncState = 'PENDING';

upsert:
INSERT OR REPLACE INTO health_day VALUES ?;

markSynced:
UPDATE health_day SET syncState = 'SYNCED' WHERE id = ? AND updatedAt = ?;

markRejected:
UPDATE health_day SET syncState = 'REJECTED' WHERE id = ? AND updatedAt = ?;

selectChangedSince:
SELECT * FROM health_day WHERE serverSeq > ? ORDER BY serverSeq ASC;
