CREATE TABLE spending (
    id TEXT NOT NULL PRIMARY KEY,
    updatedAt INTEGER NOT NULL,
    deleted INTEGER NOT NULL,
    serverSeq INTEGER NOT NULL DEFAULT 0,
    syncState TEXT NOT NULL,
    amountAgorot INTEGER NOT NULL,
    category TEXT NOT NULL,
    note TEXT,
    localDate TEXT NOT NULL
);

selectAll:
SELECT * FROM spending;

selectById:
SELECT * FROM spending WHERE id = ?;

selectPending:
SELECT * FROM spending WHERE syncState = 'PENDING';

upsert:
INSERT OR REPLACE INTO spending VALUES ?;

markSynced:
UPDATE spending SET syncState = 'SYNCED' WHERE id = ? AND updatedAt = ?;

markRejected:
UPDATE spending SET syncState = 'REJECTED' WHERE id = ? AND updatedAt = ?;

selectChangedSince:
SELECT * FROM spending WHERE serverSeq > ? ORDER BY serverSeq ASC;
