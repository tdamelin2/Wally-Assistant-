CREATE TABLE mail_draft (
    id TEXT NOT NULL PRIMARY KEY,
    updatedAt INTEGER NOT NULL,
    deleted INTEGER NOT NULL,
    serverSeq INTEGER NOT NULL DEFAULT 0,
    syncState TEXT NOT NULL,
    toAddr TEXT NOT NULL,
    subject TEXT NOT NULL,
    body TEXT NOT NULL,
    replyToGmailId TEXT,
    threadId TEXT,
    status TEXT NOT NULL,
    sentAt INTEGER,
    error TEXT
);

selectAll:
SELECT * FROM mail_draft;

selectById:
SELECT * FROM mail_draft WHERE id = ?;

selectPending:
SELECT * FROM mail_draft WHERE syncState = 'PENDING';

upsert:
INSERT OR REPLACE INTO mail_draft VALUES ?;

markSynced:
UPDATE mail_draft SET syncState = 'SYNCED' WHERE id = ? AND updatedAt = ?;

markRejected:
UPDATE mail_draft SET syncState = 'REJECTED' WHERE id = ? AND updatedAt = ?;

selectChangedSince:
SELECT * FROM mail_draft WHERE serverSeq > ? ORDER BY serverSeq ASC;

selectByStatus:
SELECT * FROM mail_draft WHERE status = ? AND deleted = 0;
