CREATE TABLE dream_pattern (
    id TEXT NOT NULL PRIMARY KEY,
    updatedAt INTEGER NOT NULL,
    deleted INTEGER NOT NULL,
    serverSeq INTEGER NOT NULL DEFAULT 0,
    syncState TEXT NOT NULL,
    localDate TEXT NOT NULL,
    text TEXT NOT NULL,
    model TEXT NOT NULL
);

selectAll:
SELECT * FROM dream_pattern;

selectById:
SELECT * FROM dream_pattern WHERE id = ?;

selectPending:
SELECT * FROM dream_pattern WHERE syncState = 'PENDING';

upsert:
INSERT OR REPLACE INTO dream_pattern VALUES ?;

markSynced:
UPDATE dream_pattern SET syncState = 'SYNCED' WHERE id = ? AND updatedAt = ?;

markRejected:
UPDATE dream_pattern SET syncState = 'REJECTED' WHERE id = ? AND updatedAt = ?;

selectChangedSince:
SELECT * FROM dream_pattern WHERE serverSeq > ? ORDER BY serverSeq ASC;
