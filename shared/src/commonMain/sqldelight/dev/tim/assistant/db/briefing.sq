CREATE TABLE briefing (
    id TEXT NOT NULL PRIMARY KEY,
    updatedAt INTEGER NOT NULL,
    deleted INTEGER NOT NULL,
    serverSeq INTEGER NOT NULL DEFAULT 0,
    syncState TEXT NOT NULL,
    localDate TEXT NOT NULL,
    text TEXT NOT NULL,
    model TEXT NOT NULL
);

selectAll:
SELECT * FROM briefing;

selectById:
SELECT * FROM briefing WHERE id = ?;

selectPending:
SELECT * FROM briefing WHERE syncState = 'PENDING';

upsert:
INSERT OR REPLACE INTO briefing VALUES ?;

markSynced:
UPDATE briefing SET syncState = 'SYNCED' WHERE id = ? AND updatedAt = ?;

markRejected:
UPDATE briefing SET syncState = 'REJECTED' WHERE id = ? AND updatedAt = ?;

selectChangedSince:
SELECT * FROM briefing WHERE serverSeq > ? ORDER BY serverSeq ASC;
