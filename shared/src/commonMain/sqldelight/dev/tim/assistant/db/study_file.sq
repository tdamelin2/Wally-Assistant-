CREATE TABLE study_file (
    id TEXT NOT NULL PRIMARY KEY,
    updatedAt INTEGER NOT NULL,
    deleted INTEGER NOT NULL,
    serverSeq INTEGER NOT NULL DEFAULT 0,
    syncState TEXT NOT NULL,
    courseId TEXT NOT NULL,
    name TEXT NOT NULL,
    origin TEXT NOT NULL,
    sizeBytes INTEGER NOT NULL,
    textStatus TEXT NOT NULL,
    studySetDocId TEXT
);

selectAll:
SELECT * FROM study_file;

selectById:
SELECT * FROM study_file WHERE id = ?;

selectPending:
SELECT * FROM study_file WHERE syncState = 'PENDING';

upsert:
INSERT OR REPLACE INTO study_file VALUES ?;

markSynced:
UPDATE study_file SET syncState = 'SYNCED' WHERE id = ? AND updatedAt = ?;

markRejected:
UPDATE study_file SET syncState = 'REJECTED' WHERE id = ? AND updatedAt = ?;

selectChangedSince:
SELECT * FROM study_file WHERE serverSeq > ? ORDER BY serverSeq ASC;

selectByCourse:
SELECT * FROM study_file WHERE deleted = 0 AND courseId = ?;
