CREATE TABLE mail_action (
    id TEXT NOT NULL PRIMARY KEY,
    updatedAt INTEGER NOT NULL,
    deleted INTEGER NOT NULL,
    serverSeq INTEGER NOT NULL DEFAULT 0,
    syncState TEXT NOT NULL,
    gmailId TEXT NOT NULL,
    action TEXT NOT NULL,
    labelId TEXT,
    labelName TEXT,
    reason TEXT NOT NULL,
    status TEXT NOT NULL
);

selectAll:
SELECT * FROM mail_action;

selectById:
SELECT * FROM mail_action WHERE id = ?;

selectPending:
SELECT * FROM mail_action WHERE syncState = 'PENDING';

upsert:
INSERT OR REPLACE INTO mail_action VALUES ?;

markSynced:
UPDATE mail_action SET syncState = 'SYNCED' WHERE id = ? AND updatedAt = ?;

markRejected:
UPDATE mail_action SET syncState = 'REJECTED' WHERE id = ? AND updatedAt = ?;

selectChangedSince:
SELECT * FROM mail_action WHERE serverSeq > ? ORDER BY serverSeq ASC;

selectByStatus:
SELECT * FROM mail_action WHERE status = ? AND deleted = 0;
