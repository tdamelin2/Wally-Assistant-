CREATE TABLE course (
    id TEXT NOT NULL PRIMARY KEY,
    updatedAt INTEGER NOT NULL,
    deleted INTEGER NOT NULL,
    serverSeq INTEGER NOT NULL DEFAULT 0,
    syncState TEXT NOT NULL,
    moodleId INTEGER,
    name TEXT NOT NULL,
    enabled INTEGER NOT NULL DEFAULT 0
);

selectAll:
SELECT * FROM course;

selectById:
SELECT * FROM course WHERE id = ?;

selectPending:
SELECT * FROM course WHERE syncState = 'PENDING';

upsert:
INSERT OR REPLACE INTO course VALUES ?;

markSynced:
UPDATE course SET syncState = 'SYNCED' WHERE id = ? AND updatedAt = ?;

markRejected:
UPDATE course SET syncState = 'REJECTED' WHERE id = ? AND updatedAt = ?;

selectChangedSince:
SELECT * FROM course WHERE serverSeq > ? ORDER BY serverSeq ASC;
