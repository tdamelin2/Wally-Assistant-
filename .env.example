# Wally does not load a .env file. This file lists every variable the project
# reads, so you know what to set. Never put real values in a committed file.
#
# The server's own settings (bind address, device tokens, Google, Spotify and
# Moodle keys) are NOT environment variables. They live in a JSON file on the
# server; copy ops/config.example.json and fill it in there.

# --- Planning workflow: Telegram connector (scripts/telegram/) ---
# Set these as Windows user settings with `setx NAME "value"` (see SETUP.md).

# Bot token of the Claude manager's bot, from @BotFather
TG_CLAUDE_TOKEN=paste-claude-bot-token-here
# Bot token of the Codex manager's bot, from @BotFather
TG_CODEX_TOKEN=paste-codex-bot-token-here
# ID of the Telegram group both bots are in (a negative number)
TG_GROUP_ID=-1000000000000

# --- Apps and tests (all optional) ---

# Path of the desktop app's SQLite file; overrides the default location
ASSISTANT_DB=C:\path\to\assistant-dev.db
# Address of the embedding model, used only by the optional live sorter tests
WALLY_EMBED_URL=http://xxxxxxxxxx
# Address of the laptop's Ollama, used only by the optional live model tests
WALLY_XPS_URL=http://xxxxxxxxxx
# Set to 1 to run the optional live tool-calling probe against a real model
WALLY_TOOL_PROBE=0
# Set to 1 to run the optional live Codex probe (needs the Codex CLI signed in)
WALLY_CODEX_PROBE=0
# Used by the optional check against your own exported chat messages (tests/acceptance, RealMessagesTest.kt)
WALLY_REAL_ACCEPT=0
# Set to any value to run the optional test that upgrades a copy of the installed laptop database
ASSISTANT_COPY_TEST=
