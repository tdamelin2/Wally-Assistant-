<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: no cloud backup and no device-to-device transfer of the database or settings. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
